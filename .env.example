# Copy this file to .env, fill in your values, then run:   source .env
# Terraform automatically reads any env var named TF_VAR_<variable_name>.

# Your home public IP (get it with: curl https://checkip.amazonaws.com)
export TF_VAR_my_public_ip="203.0.113.10"

# Name of your EC2 key pair in us-east-2 (EC2 -> Network & Security -> Key Pairs)
export TF_VAR_aws_key="my-key-pair-name"
